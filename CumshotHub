local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local running = false
local loopConnection

local oldMinZoom
local oldMaxZoom
local oldCameraType

local angle = 0
local RADIUS = 6
local HEIGHT = 2
local ROT_SPEED = 3

-- find Abyssalite anywhere
local function findAbyssalite()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj.Name == "Abyssalite" and obj.PrimaryPart then
			return obj
		end
	end
end

local Toggle = FourthTab:CreateToggle({
	Name = "Toggle Example",
	CurrentValue = false,
	Flag = "Toggle1",
	Callback = function(Value)

		if Value then
			running = true
			angle = 0

			local character = player.Character or player.CharacterAdded:Wait()
			local humanoid = character:WaitForChild("Humanoid")
			local root = character:WaitForChild("HumanoidRootPart")
			local head = character:WaitForChild("Head")

			-- save camera state
			oldMinZoom = player.CameraMinZoomDistance
			oldMaxZoom = player.CameraMaxZoomDistance
			oldCameraType = camera.CameraType

			-- TRUE first person
			player.CameraMinZoomDistance = 0
			player.CameraMaxZoomDistance = 0
			camera.CameraType = Enum.CameraType.Custom
			humanoid.AutoRotate = false

			loopConnection = RunService.RenderStepped:Connect(function(dt)
				if not running then return end

				local abyssalite = findAbyssalite()
				if not abyssalite then return end

				local center = abyssalite.PrimaryPart.Position

				-- orbit movement
				angle += dt * ROT_SPEED
				local offset = Vector3.new(
					math.cos(angle) * RADIUS,
					HEIGHT,
					math.sin(angle) * RADIUS
				)

				local pos = center + offset

				-- rotate BODY to face model
				root.CFrame = CFrame.new(pos, center)

				-- 🔒 FORCE CAMERA ROTATION (this is the missing piece)
				local camPos = camera.CFrame.Position -- let Roblox handle position
				camera.CFrame = CFrame.lookAt(camPos, center)
			end)

		else
			running = false

			if loopConnection then
				loopConnection:Disconnect()
				loopConnection = nil
			end

			-- restore camera
			player.CameraMinZoomDistance = oldMinZoom or 0.5
			player.CameraMaxZoomDistance = oldMaxZoom or 12
			camera.CameraType = oldCameraType or Enum.CameraType.Custom

			local character = player.Character
			if character and character:FindFirstChild("Humanoid") then
				character.Humanoid.AutoRotate = true
			end
		end
	end,
})
