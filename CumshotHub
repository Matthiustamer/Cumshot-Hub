blocktptab:CreateButton({
    Name = "try tp mat thing",
    Callback = function()
        if running then
            warn("already running")
            return
        end

        running = true
        stored = {}

        local char = plr.Character or plr.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        local oldPos = hrp.CFrame

        -- get item bag safely
        local bag = char:FindFirstChild("Item Bag") or plr.Backpack:FindFirstChild("Item Bag")
        if not bag then
            warn("Item Bag not found")
            running = false
            return
        end
        bag.Parent = char

        local rem = bag:WaitForChild("Action")
        local selectedMats = matbtp.CurrentOption or {}
        if #selectedMats == 0 then
            warn("no materials selected")
            running = false
            return
        end

        local count = 0

        for _, v in workspace.Grab:GetChildren() do
            if not running then break end
            if stored[v] then continue end
            if not v:FindFirstChild("Part") then continue end

            local mat = v:GetAttribute("Material")
            if not mat then continue end
            if not table.find(selectedMats, mat) then continue end

            -- move
            tweenTo(v.Part.Position, false, true)
            task.wait(MOVE_WAIT)
            if not running then break end

            -- store
            rem:FireServer("Store", v.Part)
            stored[v] = true
            count += 1

            task.wait(STORE_WAIT)
            if not running then break end

            -- drop when full
            if count >= BAG_LIMIT then
                char:PivotTo(oldPos)
                task.wait(0.3)

                for i = 1, BAG_LIMIT do
                    if not running then break end
                    rem:FireServer("Drop")
                    task.wait(DROP_WAIT)
                end

                count = 0
            end
        end

        -- final cleanup drop
        if running and count > 0 then
            char:PivotTo(oldPos)
            task.wait(0.3)

            for i = 1, count do
                if not running then break end
                rem:FireServer("Drop")
                task.wait(DROP_WAIT)
            end
        end

        running = false
        warn("tp loop finished cleanly")
    end
})

