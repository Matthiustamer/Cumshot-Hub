local currentTween: Tween?

local function stopTween()
	if currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then
		currentTween:Cancel()
	end
	currentTween = nil
end

local function tweenTo(pos: Vector3, lookAt: boolean?, waitForTween: boolean?)
    local TweenService = game:GetService("TweenService")
	local char = plr.Character
	if not char then return end

	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local targetCFrame = lookAt and CFrame.lookAt(pos, root.Position) or CFrame.new(pos)
	local dist = (root.Position - pos).Magnitude

	if currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then
		return
	end

	local tween = TweenService:Create(
		root,
		TweenInfo.new(dist / 250, Enum.EasingStyle.Linear),
		{ CFrame = targetCFrame }
	)

	currentTween = tween
	tween:Play()

	if waitForTween then
		tween.Completed:Wait()
	end
end


